{
  "entities": {
    "usuarios": {
      "title": "Usuarios",
      "description": "Perfis de administradores/gestores e alunos do aplicativo",
      "type": "object",
      "properties": {
        "id": { "type": "string" },
        "auth_id": { "type": "string" },
        "nome": { "type": "string" },
        "email": { "type": "string" },
        "telefone": { "type": "string" },
        "cpf": { "type": "string" },
        "status": { "type": "string", "enum": ["pendente", "ativo", "inativo"] },
        "role": { "type": "string", "enum": ["gestor", "aluno"] },
        "pacote": { "type": "string", "enum": ["Premium", "VIP"] },
        "recusado_em": { "type": "string" },
        "peso": { "type": "number" },
        "altura": { "type": "number" },
        "idade": { "type": "number" },
        "genero": { "type": "string", "enum": ["masculino", "feminino"] },
        "protein_meta": { "type": "number" },
        "carb_meta": { "type": "number" },
        "gordura_meta": { "type": "number" },
        "caloria_meta": { "type": "number" },
        "created_at": { "type": "string", "format": "date-time" },
        "updated_at": { "type": "string", "format": "date-time" }
      },
      "required": ["auth_id", "nome", "email", "role", "status"]
    },
    "fichas": {
      "title": "Fichas",
      "description": "Fichas de treino, dieta, avaliações e acompanhamentos",
      "type": "object",
      "properties": {
        "id": { "type": "string" },
        "user_id": { "type": "string" },
        "nome": { "type": "string" },
        "tipo": { "type": "string", "enum": ["treino", "dieta", "avaliacao", "acompanhamento"] },
        "status": { "type": "string", "enum": ["ativa", "arquivada"] },
        "data_criacao": { "type": "string", "format": "date-time" }
      },
      "required": ["user_id", "nome", "tipo", "status", "data_criacao"]
    },
    "treinos_ficha": {
      "title": "Treinos da Ficha",
      "description": "Subdivisões de treino de uma ficha (Treino A, B, C, etc.)",
      "type": "object",
      "properties": {
        "id": { "type": "string" },
        "ficha_id": { "type": "string" },
        "letra_ou_nome": { "type": "string" },
        "observacoes": { "type": "string" },
        "created_at": { "type": "string", "format": "date-time" }
      },
      "required": ["ficha_id", "letra_ou_nome"]
    },
    "exercicios_treino": {
      "title": "Exercícios do Treino",
      "description": "Exercícios prescritos em cada treino",
      "type": "object",
      "properties": {
        "id": { "type": "string" },
        "treino_id": { "type": "string" },
        "nome_exercicio": { "type": "string" },
        "grupo_muscular": { "type": "string" },
        "musculo_principal": { "type": "string" },
        "series": { "type": "number" },
        "repeticoes_prescritas": { "type": "string" },
        "repeticoes_por_serie": { "type": "array", "items": { "type": "string" } },
        "series_aquecimento": { "type": "array", "items": { "type": "boolean" } },
        "descanso": { "type": "number" },
        "ordem": { "type": "number" },
        "categoria": { "type": "string", "enum": ["forca", "cardio"] },
        "meta_tempo_min": { "type": "number" },
        "meta_distancia_km": { "type": "number" }
      },
      "required": ["treino_id", "nome_exercicio"]
    },
    "refeicoes_dieta": {
      "title": "Refeições da Dieta",
      "description": "Refeições prescritas na ficha de dieta",
      "type": "object",
      "properties": {
        "id": { "type": "string" },
        "ficha_id": { "type": "string" },
        "nome_refeicao": { "type": "string" },
        "descricao_alimentos": { "type": "string" },
        "horario": { "type": "string" },
        "ordem": { "type": "number" },
        "created_at": { "type": "string", "format": "date-time" }
      },
      "required": ["ficha_id", "nome_refeicao"]
    },
    "avaliacoes_os": {
      "title": "Avaliações OS",
      "description": "Registros detalhados de avaliação física",
      "type": "object",
      "properties": {
        "id": { "type": "string" },
        "ficha_id": { "type": "string" },
        "user_id": { "type": "string" },
        "anamnese": { "type": "string" },
        "perimetros": { "type": "object" },
        "composicao": { "type": "object" },
        "flexibilidade_forca": { "type": "string" },
        "objetivo": { "type": "string" },
        "peso": { "type": "number" },
        "altura": { "type": "number" },
        "created_at": { "type": "string", "format": "date-time" }
      },
      "required": ["ficha_id"]
    },
    "acompanhamentos_os": {
      "title": "Acompanhamentos OS",
      "description": "Registros periódicos de acompanhamento e metas nutricionais",
      "type": "object",
      "properties": {
        "id": { "type": "string" },
        "ficha_id": { "type": "string" },
        "user_id": { "type": "string" },
        "relato": { "type": "string" },
        "feedback": { "type": "string" },
        "fotos": { "type": "array", "items": { "type": "string" } },
        "peso": { "type": "number" },
        "meta_kcal": { "type": "number" },
        "meta_proteina": { "type": "number" },
        "meta_carbo": { "type": "number" },
        "meta_gordura": { "type": "number" },
        "meta_fibra": { "type": "number" },
        "created_at": { "type": "string", "format": "date-time" }
      },
      "required": ["ficha_id"]
    },
    "logs_execucao": {
      "title": "Logs de Execução",
      "description": "Registro de séries, cargas e repetições executadas pelo aluno",
      "type": "object",
      "properties": {
        "id": { "type": "string" },
        "exercicio_id": { "type": "string" },
        "carga": { "type": "number" },
        "repeticoes_realizadas": { "type": "number" },
        "serie_valida": { "type": "boolean" },
        "is_warmup": { "type": "boolean" },
        "num_serie": { "type": "number" },
        "data_registro": { "type": "string", "format": "date-time" },
        "data_treino": { "type": "string" },
        "log_treino_id": { "type": "string" }
      },
      "required": ["exercicio_id", "data_treino"]
    },
    "logs_cardio": {
      "title": "Logs de Cardio",
      "description": "Registro de execuções de atividades aeróbicas",
      "type": "object",
      "properties": {
        "id": { "type": "string" },
        "exercicio_id": { "type": "string" },
        "duracao_min": { "type": "number" },
        "distancia_km": { "type": "number" },
        "data_treino": { "type": "string" },
        "log_treino_id": { "type": "string" },
        "data_registro": { "type": "string", "format": "date-time" }
      },
      "required": ["exercicio_id", "data_treino", "duracao_min"]
    },
    "logs_treino": {
      "title": "Logs de Treino",
      "description": "Sessões concluídas com cronômetro e duração",
      "type": "object",
      "properties": {
        "id": { "type": "string" },
        "user_id": { "type": "string" },
        "treino_id": { "type": "string" },
        "data_execucao": { "type": "string", "format": "date-time" },
        "duracao_segundos": { "type": "number" }
      },
      "required": ["user_id", "treino_id", "duracao_segundos"]
    },
    "planejamento_semanal": {
      "title": "Planejamento Semanal",
      "description": "Alocação de treinos nos dias da semana",
      "type": "object",
      "properties": {
        "id": { "type": "string" },
        "user_id": { "type": "string" },
        "dia_semana": { "type": "number" },
        "treino_id": { "type": "string" },
        "is_descanso": { "type": "boolean" },
        "ordem": { "type": "number" }
      },
      "required": ["user_id", "dia_semana"]
    },
    "meals": {
      "title": "Refeições Consumidas",
      "description": "Refeições e calorias/macros consumidos diariamente",
      "type": "object",
      "properties": {
        "id": { "type": "string" },
        "user_id": { "type": "string" },
        "date": { "type": "string" },
        "meal_label": { "type": "string" },
        "food_description": { "type": "string" },
        "calories": { "type": "number" },
        "carbs": { "type": "number" },
        "protein": { "type": "number" },
        "fat": { "type": "number" },
        "fiber": { "type": "number" },
        "ai_raw_response": { "type": "string" },
        "created_at": { "type": "string", "format": "date-time" }
      },
      "required": ["user_id", "date", "meal_label"]
    },
    "fixed_foods": {
      "title": "Alimentos Fixos",
      "description": "Alimentos pré-configurados do usuário",
      "type": "object",
      "properties": {
        "id": { "type": "string" },
        "user_id": { "type": "string" },
        "name": { "type": "string" },
        "calories": { "type": "number" },
        "carbs": { "type": "number" },
        "protein": { "type": "number" },
        "fat": { "type": "number" },
        "fiber": { "type": "number" },
        "is_active": { "type": "boolean" }
      },
      "required": ["user_id", "name"]
    },
    "activities": {
      "title": "Atividades",
      "description": "Atividades físicas semanais",
      "type": "object",
      "properties": {
        "id": { "type": "string" },
        "user_id": { "type": "string" },
        "day_of_week": { "type": "number" },
        "activity_type": { "type": "string" },
        "duration_minutes": { "type": "number" },
        "is_default": { "type": "boolean" }
      },
      "required": ["user_id", "day_of_week"]
    },
    "muscle_group_goals": {
      "title": "Metas por Grupo Muscular",
      "description": "Metas de séries válidas por grupo muscular",
      "type": "object",
      "properties": {
        "id": { "type": "string" },
        "user_id": { "type": "string" },
        "muscle_group": { "type": "string" },
        "target_valid_sets": { "type": "number" }
      },
      "required": ["user_id", "muscle_group"]
    },
    "avaliacoes_fisicas": {
      "title": "Avaliações Físicas",
      "description": "Registros de avaliações físicas",
      "type": "object",
      "properties": {
        "id": { "type": "string" },
        "id_cliente": { "type": "string" },
        "anamnese": { "type": "string" },
        "perimetros": { "type": "object" },
        "composicao": { "type": "object" },
        "flexibilidade_forca": { "type": "string" },
        "objetivo": { "type": "string" },
        "peso": { "type": "number" },
        "altura": { "type": "number" },
        "created_at": { "type": "string", "format": "date-time" },
        "updated_at": { "type": "string", "format": "date-time" }
      },
      "required": ["id_cliente"]
    }
  }
}
