rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {
    
    function isAuthenticated() {
      return request.auth != null;
    }

    function isOwner(userId) {
      return isAuthenticated() && (request.auth.uid == userId);
    }

    // Colecao de usuarios
    match /usuarios/{userId} {
      allow read: if isAuthenticated();
      allow write: if isAuthenticated();
    }

    // Colecao de fichas
    match /fichas/{fichaId} {
      allow read: if isAuthenticated();
      allow write: if isAuthenticated();
    }

    // Treinos da ficha
    match /treinos_ficha/{treinoId} {
      allow read: if isAuthenticated();
      allow write: if isAuthenticated();
    }

    // Exercicios do treino
    match /exercicios_treino/{exercicioId} {
      allow read: if isAuthenticated();
      allow write: if isAuthenticated();
    }

    // Refeicoes da dieta
    match /refeicoes_dieta/{refeicaoId} {
      allow read: if isAuthenticated();
      allow write: if isAuthenticated();
    }

    // Ordens de servico
    match /avaliacoes_os/{osId} {
      allow read: if isAuthenticated();
      allow write: if isAuthenticated();
    }

    match /acompanhamentos_os/{osId} {
      allow read: if isAuthenticated();
      allow write: if isAuthenticated();
    }

    // Logs de treino, execucao e cardio
    match /logs_execucao/{logId} {
      allow read: if isAuthenticated();
      allow write: if isAuthenticated();
    }

    match /logs_cardio/{logId} {
      allow read: if isAuthenticated();
      allow write: if isAuthenticated();
    }

    match /logs_treino/{logId} {
      allow read: if isAuthenticated();
      allow write: if isAuthenticated();
    }

    // Planejamento semanal
    match /planejamento_semanal/{planId} {
      allow read: if isAuthenticated();
      allow write: if isAuthenticated();
    }

    // Meals, Fixed foods, Activities, Muscle goals
    match /meals/{mealId} {
      allow read: if isAuthenticated();
      allow write: if isAuthenticated();
    }

    match /fixed_foods/{foodId} {
      allow read: if isAuthenticated();
      allow write: if isAuthenticated();
    }

    match /activities/{actId} {
      allow read: if isAuthenticated();
      allow write: if isAuthenticated();
    }

    match /muscle_group_goals/{goalId} {
      allow read: if isAuthenticated();
      allow write: if isAuthenticated();
    }

    match /avaliacoes_fisicas/{avId} {
      allow read: if isAuthenticated();
      allow write: if isAuthenticated();
    }

    // Default rule for all other documents
    match /{document=**} {
      allow read, write: if isAuthenticated();
    }
  }
}
